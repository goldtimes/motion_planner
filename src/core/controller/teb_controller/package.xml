<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format2.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>teb_controller</name>
  <version>0.0.1</version>
  <description>
    TEB (Timed Elastic Band) local planner implementation using Ceres-solver.
    This package provides a local trajectory planner that optimizes a sequence
    of robot poses with time intervals using sparse nonlinear optimization.
  </description>
  <author>Generated</author>
  <maintainer email="user@example.com">user</maintainer>
  <license>GPL3</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>angles</build_depend>
  <build_depend>cmake_modules</build_depend>

  <depend>base_local_planner</depend>
  <depend>controller</depend>
  <depend>costmap_2d</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>system_config</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <nav_core plugin="${prefix}/teb_controller_plugin.xml" />
  </export>
</package>

<?xml version="1.0"?>
<package format="2">
  <name>my_dwa_controller</name>
  <version>0.0.1</version>
  <description>
    A clean self-contained implementation of the Dynamic Window Approach (DWA)
    for local robot navigation. Built from scratch for educational purposes,
    with explicit velocity sampling, trajectory prediction, and cost evaluation.
  </description>
  <maintainer email="user@example.com">user</maintainer>
  <license>GPL3</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>base_local_planner</depend>
  <depend>angles</depend>
  <depend>costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>common</depend>

  <export>
    <nav_core plugin="${prefix}/my_dwa_controller_plugin.xml" />
  </export>
</package>
